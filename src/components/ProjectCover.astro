---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
---

<div class="cover" style={`--accent: ${project.accent};`}>
  {project.image ? (
    <Image
      src={project.image}
      alt={project.imageAlt?.[lang] ?? project.name}
      widths={[480, 800, 1280]}
      sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 560px"
      loading="lazy"
    />
  ) : (
    <svg
      class="cover__art"
      viewBox="0 0 640 400"
      role="img"
      aria-label={`${project.name} cover art`}
      preserveAspectRatio="xMidYMid slice"
    >
      {project.slug === 'testtracker' && (
        <g fill="none" stroke="var(--accent)" stroke-width="2">
          <path
            d="M320 62 L458 116 V228 C458 302 395 344 320 372 C245 344 182 302 182 228 V116 Z"
            opacity="0.42"
          />
          <path
            d="M320 92 L424 134 V224 C424 280 378 313 320 336 C262 313 216 280 216 224 V134 Z"
            opacity="0.22"
            stroke-dasharray="5 8"
          />
          <rect x="292" y="202" width="56" height="48" rx="4" opacity="0.9" />
          <path d="M304 202 V184 C304 168 336 168 336 184 V202" opacity="0.9" />
          <circle cx="320" cy="224" r="5" fill="var(--accent)" stroke="none" />
          <path d="M320 229 V239" opacity="0.9" />
          <path d="M86 103 H146 M86 123 H226 M86 143 H186" opacity="0.28" />
          <path d="M494 103 H554 M414 123 H554 M454 143 H554" opacity="0.28" />
          <g fill="var(--accent)" stroke="none" opacity="0.85">
            <rect x="238" y="316" width="14" height="26" />
            <rect x="258" y="306" width="14" height="36" />
            <rect x="278" y="292" width="14" height="50" />
            <rect x="298" y="306" width="14" height="36" />
            <rect x="318" y="322" width="14" height="20" />
          </g>
          <path d="M238 352 H332" opacity="0.4" />
          <text class="cover__svg-label" x="72" y="68">
            TESTTRACKER / VAULT
          </text>
          <text class="cover__svg-label" x="72" y="356">
            SEVERITY MATRIX
          </text>
          <text class="cover__svg-label" x="238" y="374">
            ENCRYPTED EVIDENCE
          </text>
        </g>
      )}

      {project.slug === 'yun' && (
        <g fill="none" stroke="var(--accent)" stroke-width="1.8">
          <g opacity="0.16" stroke-width="1">
            {Array.from({ length: 13 }, (_, i) => (
              <path d={`M${i * 52 + 20} 20 V380`} />
            ))}
            {Array.from({ length: 8 }, (_, i) => (
              <path d={`M20 ${i * 52 + 20} H620`} />
            ))}
          </g>
          <rect x="88" y="86" width="168" height="112" rx="5" fill="rgba(110,231,255,.06)" />
          <rect x="302" y="64" width="132" height="86" rx="5" fill="rgba(110,231,255,.04)" />
          <rect x="468" y="112" width="104" height="146" rx="5" fill="rgba(110,231,255,.05)" />
          <rect x="186" y="248" width="192" height="92" rx="5" fill="rgba(110,231,255,.04)" />
          <path d="M256 142 H302" stroke-dasharray="4 6" opacity="0.6" />
          <path d="M434 110 H468" stroke-dasharray="4 6" opacity="0.6" />
          <path d="M270 198 V248" stroke-dasharray="4 6" opacity="0.6" />
          <path d="M420 258 H468" stroke-dasharray="4 6" opacity="0.6" />
          <circle cx="302" cy="142" r="3" fill="var(--accent)" />
          <circle cx="468" cy="110" r="3" fill="var(--accent)" />
          <circle cx="270" cy="248" r="3" fill="var(--accent)" />
          <circle cx="468" cy="258" r="3" fill="var(--accent)" />
          <path d="M114 112 H160 M114 128 H190 M114 144 H146" opacity="0.5" />
          <path d="M324 86 H384 M324 102 H360" opacity="0.5" />
          <path d="M486 136 H542 M486 152 H522" opacity="0.5" />
          <path d="M208 272 H314 M208 288 H284" opacity="0.5" />
          <path
            d="M526 330 V304 L544 316 L526 328"
            fill="var(--accent)"
            stroke="none"
            opacity="0.8"
          />
          <rect x="500" y="326" width="94" height="42" rx="3" opacity="0.35" />
          <path d="M512 340 H580 M512 350 H562" opacity="0.5" />
          <text class="cover__svg-label" x="72" y="52">
            YUN / CANVAS IDE
          </text>
          <text class="cover__svg-label" x="486" y="388">
            32 FILES · 6 LINKS
          </text>
        </g>
      )}

      {project.slug === 'functional-c3' && (
        <g fill="none" stroke="var(--accent)" stroke-width="2">
          <path
            d="M92 200 H170 M246 200 H314 M390 200 H458 M534 200 H566"
            stroke-dasharray="5 7"
            opacity="0.55"
          />
          <circle cx="208" cy="200" r="34" fill="rgba(255,204,102,.08)" />
          <rect
            x="290"
            y="166"
            width="68"
            height="68"
            rx="6"
            fill="rgba(255,204,102,.06)"
            transform="rotate(45 324 200)"
          />
          <path d="M442 166 L478 232 H406 Z" fill="rgba(255,204,102,.08)" />
          <circle cx="550" cy="200" r="18" fill="rgba(255,204,102,.12)" />
          <path d="M170 194 L184 200 L170 206" />
          <path d="M314 194 L328 200 L314 206" />
          <path d="M458 194 L472 200 L458 206" />
          <text class="cover__svg-label" x="188" y="258">
            map
          </text>
          <text class="cover__svg-label" x="304" y="258">
            filter
          </text>
          <text class="cover__svg-label" x="432" y="258">
            for_each
          </text>
          <path d="M86 300 H554" opacity="0.2" />
          <path d="M86 312 H420" opacity="0.12" />
          <text class="cover__svg-label" x="72" y="78">
            FUNCTIONAL C3 / SLICES
          </text>
          <text class="cover__svg-label" x="72" y="352">
            PURE C3 · COMPILE-TIME GENERICS
          </text>
        </g>
      )}

      {project.slug === 'flecs-c3' && (
        <g fill="none" stroke="var(--accent)" stroke-width="1.8">
          {Array.from({ length: 8 }, (_, x) =>
            Array.from({ length: 5 }, (_, y) => {
              const filled =
                (x === 2 && y === 1) ||
                (x === 5 && y === 2) ||
                (x === 3 && y === 4) ||
                (x === 6 && y === 0);
              return (
                <rect
                  x={116 + x * 54}
                  y={96 + y * 48}
                  width="24"
                  height="24"
                  fill={filled ? 'var(--accent)' : 'transparent'}
                  opacity={filled ? 0.75 : 0.25}
                />
              );
            }),
          )}
          <path
            d="M232 148 L368 196 M396 172 L470 120 M244 180 L262 288 M410 148 L452 288"
            stroke-dasharray="4 6"
            opacity="0.55"
          />
          <circle cx="232" cy="148" r="7" fill="var(--accent)" />
          <circle cx="368" cy="196" r="7" fill="var(--accent)" />
          <circle cx="470" cy="120" r="7" fill="var(--accent)" />
          <circle cx="262" cy="288" r="7" fill="var(--accent)" />
          <circle cx="452" cy="288" r="7" fill="var(--accent)" />
          <path d="M192 352 H448" opacity="0.25" />
          <text class="cover__svg-label" x="72" y="70">
            FLECS 4.1.6 / C3
          </text>
          <text class="cover__svg-label" x="72" y="352">
            ENTITY · COMPONENT · SYSTEM
          </text>
        </g>
      )}

      {project.slug === 'lua54-c3l' && (
        <g fill="none" stroke="var(--accent)" stroke-width="2">
          <path
            d="M438 80 C374 80 322 132 322 196 C322 260 374 312 438 312 C412 288 396 246 396 196 C396 146 412 104 438 80 Z"
            fill="rgba(122,162,255,.12)"
          />
          <path d="M438 80 C374 80 322 132 322 196 C322 260 374 312 438 312 C412 288 396 246 396 196 C396 146 412 104 438 80 Z" />
          <path
            d="M64 280 C114 252 164 308 214 280 C264 252 314 308 364 280 C414 252 464 308 514 280 C548 260 578 284 596 276"
            opacity="0.55"
          />
          <path
            d="M64 306 C114 278 164 334 214 306 C264 278 314 334 364 306 C414 278 464 334 514 306 C548 286 578 310 596 302"
            opacity="0.3"
          />
          <circle cx="146" cy="122" r="3" fill="var(--accent)" />
          <circle cx="206" cy="86" r="2" fill="var(--accent)" />
          <circle cx="118" cy="196" r="2" fill="var(--accent)" />
          <text class="cover__svg-label" x="72" y="60">
            LUA 5.4 / C3L
          </text>
          <text class="cover__svg-label" x="72" y="352">
            EXPERIMENTAL RUNTIME
          </text>
        </g>
      )}

      {project.slug === 'lua-space' && (
        <g fill="none" stroke="var(--accent)" stroke-width="1.6">
          <circle cx="320" cy="200" r="300" opacity="0.06" />
          <ellipse cx="320" cy="200" rx="220" ry="116" opacity="0.28" />
          <ellipse
            cx="320"
            cy="200"
            rx="162"
            ry="82"
            opacity="0.24"
            transform="rotate(-18 320 200)"
          />
          <ellipse
            cx="320"
            cy="200"
            rx="104"
            ry="48"
            opacity="0.2"
            transform="rotate(22 320 200)"
          />
          <circle cx="320" cy="200" r="34" fill="rgba(255,159,90,.18)" />
          <circle cx="320" cy="200" r="12" fill="var(--accent)" stroke="none" />
          <circle cx="508" cy="142" r="13" fill="rgba(255,159,90,.28)" />
          <circle cx="218" cy="262" r="9" fill="rgba(255,159,90,.3)" />
          <circle cx="382" cy="112" r="7" fill="rgba(255,159,90,.35)" />
          <circle cx="512" cy="268" r="5" fill="var(--accent)" />
          <circle cx="116" cy="116" r="2" fill="var(--accent)" />
          <circle cx="182" cy="72" r="2" fill="var(--accent)" />
          <circle cx="558" cy="70" r="2" fill="var(--accent)" />
          <circle cx="580" cy="330" r="2" fill="var(--accent)" />
          <text class="cover__svg-label" x="72" y="60">
            LUA SPACE / CO-OP ARCADE
          </text>
          <text class="cover__svg-label" x="452" y="360">
            3 PLANETS · 1 FRIEND
          </text>
        </g>
      )}

      {project.slug === 'wgpu-in-odin' && (
        <g fill="none" stroke="var(--accent)" stroke-width="1.8">
          <path d="M320 84 L152 326 H488 Z" opacity="0.7" />
          <path
            d="M320 84 L320 326 M152 326 L414 244 M488 326 L226 244"
            opacity="0.22"
            stroke-dasharray="4 7"
          />
          <path d="M320 150 L238 280 H402 Z" fill="rgba(94,234,212,.08)" opacity="0.8" />
          <path d="M78 326 H562" opacity="0.3" />
          <path d="M78 326 V86" opacity="0.3" />
          <path d="M78 326 L118 306 M78 326 L98 366" opacity="0.3" />
          <circle cx="320" cy="84" r="4" fill="var(--accent)" />
          <circle cx="152" cy="326" r="4" fill="var(--accent)" />
          <circle cx="488" cy="326" r="4" fill="var(--accent)" />
          <text class="cover__svg-label" x="72" y="60">
            WGPU / ODIN
          </text>
          <text class="cover__svg-label" x="492" y="360">
            WGSL
          </text>
        </g>
      )}

      {![
        'testtracker',
        'yun',
        'functional-c3',
        'flecs-c3',
        'lua54-c3l',
        'lua-space',
        'wgpu-in-odin',
      ].includes(project.slug) && (
        <text x="320" y="230" text-anchor="middle" class="cover__fallback" fill="var(--accent)">
          {project.glyph}
        </text>
      )}
    </svg>
  )}
  <span class="cover__tag" aria-hidden="true">
    {project.slug}.sys
  </span>
</div>

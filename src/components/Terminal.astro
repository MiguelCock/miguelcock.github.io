---
import { terminalCopy } from '../i18n/terminal';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  alternatePath: string;
}

const { lang, alternatePath } = Astro.props;
const copy = terminalCopy[lang];
---

<div class="terminal" data-terminal data-lang={lang} data-alternate={alternatePath}>
  <div class="terminal__bar">
    <span class="terminal__dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="terminal__title">{copy.windowTitle}</span>
    <span class="terminal__dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
  </div>
  <div class="terminal__body">
    <div class="terminal__output" data-terminal-output aria-live="polite">
      <p>
        <span class="prompt">miguel@medellin:~$</span> ./welcome.sh
      </p>
      {copy.welcome.map((line) => (
        <p>{line}</p>
      ))}
    </div>
    <form class="terminal__form" data-terminal-form>
      <label class="sr-only" for={`terminal-input-${lang}`}>
        {copy.inputLabel}
      </label>
      <span class="prompt" aria-hidden="true">
        miguel@medellin:~$
      </span>
      <input
        class="terminal__input"
        id={`terminal-input-${lang}`}
        name={`terminal-${lang}`}
        type="text"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        placeholder="help"
        data-terminal-input
      />
    </form>
    <div class="terminal__hints" aria-label={copy.hint}>
      {['whoami', 'projects', 'skills', 'contact', 'lang'].map((command) => (
        <button class="terminal__hint" type="button" data-command={command}>
          {command}
        </button>
      ))}
    </div>
    <p class="terminal__caption">{copy.hint}</p>
  </div>
  <div class="terminal__status">
    <span class="terminal__status-item">
      <i class="terminal__led" aria-hidden="true"></i>
      {lang === 'en' ? 'ONLINE' : 'EN LÍNEA'}
    </span>
    <span class="terminal__status-item">{lang === 'en' ? 'SND:OFF' : 'SON:OFF'}</span>
    <span class="terminal__status-item">{lang === 'en' ? 'P1:GRN' : 'P1:VERDE'}</span>
    <span class="terminal__clock" data-terminal-clock>
      MED --:--
    </span>
  </div>
</div>

<script>
  import { terminalCopy } from '../i18n/terminal';
  import { profile } from '../data/profile';

  type Lang = 'en' | 'es';

  const promptText = 'miguel@medellin:~$ ';

  function bootTerminal(): void {
    document.querySelectorAll<HTMLElement>('[data-terminal]').forEach((root) => {
      if (root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const lang = (root.dataset.lang === 'es' ? 'es' : 'en') as Lang;
      const copy = terminalCopy[lang];
      const output = root.querySelector<HTMLElement>('[data-terminal-output]');
      const form = root.querySelector<HTMLFormElement>('[data-terminal-form]');
      const input = root.querySelector<HTMLInputElement>('[data-terminal-input]');
      const alternatePath = root.dataset.alternate || (lang === 'es' ? '/' : '/es/');
      if (!output || !form || !input) return;

      let historyIndex = -1;
      const history: string[] = [];

      const clock = root.querySelector<HTMLElement>('[data-terminal-clock]');
      if (clock) {
        const format = new Intl.DateTimeFormat(lang === 'es' ? 'es-CO' : 'en-GB', {
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'America/Bogota',
        });
        const tick = () => {
          clock.textContent = `MED ${format.format(new Date())}`;
        };
        tick();
        const clockWin = window as Window & { __mcTerminalClock?: number };
        if (clockWin.__mcTerminalClock) window.clearInterval(clockWin.__mcTerminalClock);
        clockWin.__mcTerminalClock = window.setInterval(tick, 30_000);
      }

      const scroll = () => {
        output.scrollTop = output.scrollHeight;
      };

      const line = (text: string, className?: string) => {
        const p = document.createElement('p');
        p.textContent = text;
        if (className) p.classList.add(className);
        output.appendChild(p);
        return p;
      };

      const commandLine = (command: string) => {
        const p = document.createElement('p');
        p.className = 'terminal__line--cmd';
        const prompt = document.createElement('span');
        prompt.className = 'prompt';
        prompt.textContent = promptText;
        p.append(prompt, document.createTextNode(command));
        output.appendChild(p);
      };

      const print = (lines: string[], className?: string) => {
        lines.forEach((text) => line(text, className));
        scroll();
      };

      const run = (raw: string) => {
        const command = raw.trim();
        if (!command) return;

        commandLine(command);

        if (command === 'clear') {
          output.replaceChildren();
          print(copy.cleared);
          return;
        }

        if (command === 'lang') {
          print(lang === 'en' ? ['Switching to Spanish...'] : ['Cambiando a inglés...'], 'is-ok');
          window.setTimeout(() => {
            window.location.href = alternatePath;
          }, 420);
          return;
        }

        if (command === 'history') {
          print(
            history.length ? history.map((item, index) => `${index + 1}  ${item}`) : ['(empty)'],
          );
          return;
        }

        if (command === 'cd /projects' || command === 'cd /es/proyectos') {
          print([
            lang === 'en'
              ? 'Opening https://miguelcock.github.io/projects/'
              : 'Abriendo https://miguelcock.github.io/es/proyectos/',
          ]);
          window.setTimeout(() => {
            window.location.href = lang === 'en' ? '/projects/' : '/es/proyectos/';
          }, 420);
          return;
        }

        if (command === 'email') {
          print([profile.email], 'is-ok');
          return;
        }

        const outputLines = copy.commands[command];
        if (outputLines) {
          print(outputLines);
        } else {
          print([copy.unknown(command)], 'is-error');
        }
      };

      form.addEventListener('submit', (event) => {
        event.preventDefault();
        const value = input.value;
        if (!value.trim()) return;
        history.push(value.trim());
        historyIndex = -1;
        run(value);
        input.value = '';
      });

      input.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowUp') {
          if (history.length === 0) return;
          event.preventDefault();
          if (historyIndex === -1) historyIndex = history.length - 1;
          else historyIndex = Math.max(0, historyIndex - 1);
          input.value = history[historyIndex] ?? '';
          input.setSelectionRange(input.value.length, input.value.length);
        }

        if (event.key === 'ArrowDown') {
          if (historyIndex === -1) return;
          event.preventDefault();
          historyIndex += 1;
          if (historyIndex >= history.length) {
            historyIndex = -1;
            input.value = '';
          } else {
            input.value = history[historyIndex] ?? '';
          }
        }

        if (event.key === 'Tab') {
          const commands = Object.keys(copy.commands).concat(['clear', 'history', 'lang']);
          const matches = commands.filter((command) => command.startsWith(input.value.trim()));
          if (matches.length === 1) {
            event.preventDefault();
            input.value = matches[0] ?? '';
          }
        }
      });

      root.querySelectorAll<HTMLButtonElement>('[data-command]').forEach((button) => {
        button.addEventListener('click', () => {
          const command = button.dataset.command;
          if (!command) return;
          history.push(command);
          run(command);
          input.focus();
        });
      });

      output.addEventListener('click', () => input.focus());
    });
  }

  document.addEventListener('astro:page-load', bootTerminal);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootTerminal, { once: true });
  } else {
    bootTerminal();
  }
</script>

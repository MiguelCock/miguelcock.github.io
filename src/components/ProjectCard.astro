---
import { Image } from 'astro:assets';
import ProjectCover from './ProjectCover.astro';
import type { Project } from '../data/projects';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  project: Project;
  lang: Lang;
  index?: number;
}

const { project, lang, index = 0 } = Astro.props;
const copy = t(lang);
const repo = project.repo;
const caseStudy = project.caseStudy?.[lang];
const gallery = project.gallery?.[0];
const indexLabel = String(index + 1).padStart(3, '0');
const search = [
  indexLabel,
  project.name,
  project.role[lang],
  project.tagline[lang],
  project.description[lang],
  project.stack.join(' '),
  project.tags.join(' '),
]
  .join(' ')
  .toLowerCase();

const notes = {
  en: { label: 'Case notes', role: 'Role', period: 'Period', work: 'What I did' },
  es: { label: 'Notas del caso', role: 'Rol', period: 'Periodo', work: 'Qué hice' },
}[lang];
---

<article
  class="project-card"
  data-reveal
  data-project-card
  data-tags={project.tags.join(' ')}
  data-search={search}
  style={`--accent: ${project.accent}; --i: ${index};`}
>
  <div class="project-card__bar">
    <span class="terminal__dots" aria-hidden="true">
      <i></i>
      <i></i>
      <i></i>
    </span>
    <span class="project-card__file">
      {indexLabel} · {project.slug}.md
    </span>
    <span class="project-card__period">{project.period}</span>
  </div>

  {repo ? (
    <a
      class="project-card__media"
      href={repo}
      target="_blank"
      rel="noopener noreferrer"
      tabindex="-1"
      aria-hidden="true"
    >
      <ProjectCover project={project} lang={lang} />
    </a>
  ) : (
    <div class="project-card__media">
      <ProjectCover project={project} lang={lang} />
    </div>
  )}

  <div class="project-card__body">
    <div class="project-card__head">
      <span class="project-card__glyph" aria-hidden="true">
        {project.glyph}
      </span>
      <div>
        <h3>
          {repo ? (
            <a href={repo} target="_blank" rel="noopener noreferrer">
              {project.name}
            </a>
          ) : (
            project.name
          )}
        </h3>
        <p class="project-card__status">{project.status[lang]}</p>
      </div>
    </div>

    <p class="project-card__tagline">{project.tagline[lang]}</p>
    <p class="project-card__desc">{project.description[lang]}</p>

    <ul class="tags" aria-label={copy.common.stack}>
      {project.stack.map((item) => (
        <li class="tag">{item}</li>
      ))}
    </ul>

    <div class="project-card__links">
      {repo && (
        <a href={repo} target="_blank" rel="noopener noreferrer">
          {copy.common.repo} <span aria-hidden="true">↗</span>
        </a>
      )}
      {caseStudy && <a href={caseStudy}>{copy.common.readMore} →</a>}
    </div>
  </div>

  <details class="case-notes">
    <summary>
      <span class="case-notes__plus" aria-hidden="true">
        +
      </span>
      {notes.label}
    </summary>
    <div class="case-notes__body">
      <dl class="case-notes__meta">
        <div>
          <dt>{notes.role}</dt>
          <dd>{project.role[lang]}</dd>
        </div>
        <div>
          <dt>{notes.period}</dt>
          <dd>{project.period}</dd>
        </div>
      </dl>
      <p class="case-notes__label">{notes.work}</p>
      <ul class="case-notes__list">
        {project.highlights[lang].map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      {gallery && (
        <div class="case-notes__gallery">
          <Image
            src={gallery.image}
            alt={gallery.alt[lang]}
            widths={[320, 640]}
            sizes="(max-width: 760px) 100vw, 420px"
            loading="lazy"
          />
        </div>
      )}
    </div>
  </details>
</article>

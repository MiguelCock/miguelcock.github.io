---
interface Props {
  eyebrow: string;
  title: string;
  link?: string;
  linkLabel?: string;
  index?: string;
}

const { eyebrow, title, link, linkLabel, index } = Astro.props;
---

<div class="section-head">
  <div class="section-head__copy">
    {index && (
      <span class="section-head__ghost" aria-hidden="true">
        {index}
      </span>
    )}
    <p class="eyebrow">
      <span class="eyebrow__mark">//</span> {eyebrow}
    </p>
    <h2 class="section-title">
      {title}
      <span class="accent">.</span>
    </h2>
  </div>
  {link && linkLabel && (
    <a class="section-link" href={link}>
      {linkLabel} →
    </a>
  )}
</div>

---
---

<div class="hero-scene" data-hero-scene aria-hidden="true">
  <canvas data-hero-canvas></canvas>
</div>

<script>
  type Star = { x: number; y: number; r: number; a: number; speed: number; phase: number };

  function bootHeroScene(): void {
    const scene = document.querySelector<HTMLElement>('[data-hero-scene]');
    const canvas = scene?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
    if (!scene || !canvas || scene.dataset.ready === 'true') return;
    scene.dataset.ready = 'true';

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    let width = 0;
    let height = 0;
    let stars: Star[] = [];
    let frame = 0;
    let visible = true;
    let pointerX = 0.5;
    let pointerY = 0.5;
    let targetX = 0.5;
    let targetY = 0.5;

    const seed = () => {
      const count = Math.round(Math.min(90, Math.max(40, (width * height) / 16000)));
      stars = Array.from({ length: count }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        r: Math.random() * 1.4 + 0.3,
        a: Math.random() * 0.5 + 0.15,
        speed: Math.random() * 0.08 + 0.01,
        phase: Math.random() * Math.PI * 2,
      }));
    };

    const resize = () => {
      const rect = scene.getBoundingClientRect();
      width = Math.max(1, rect.width);
      height = Math.max(1, rect.height);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
      draw(performance.now());
    };

    const drawGlow = (x: number, y: number, radius: number, color: string, alpha: number) => {
      const gradient = ctx.createRadialGradient(x, y, 0, x, y, radius);
      gradient.addColorStop(0, color.replace('ALPHA', String(alpha)));
      gradient.addColorStop(1, color.replace('ALPHA', '0'));
      ctx.fillStyle = gradient;
      ctx.beginPath();
      ctx.arc(x, y, radius, 0, Math.PI * 2);
      ctx.fill();
    };

    const draw = (time: number) => {
      ctx.clearRect(0, 0, width, height);
      ctx.globalCompositeOperation = 'lighter';

      pointerX += (targetX - pointerX) * 0.04;
      pointerY += (targetY - pointerY) * 0.04;

      const t = time * 0.00012;
      drawGlow(
        width * (0.16 + Math.sin(t * 1.7) * 0.05) + pointerX * 40,
        height * (0.22 + Math.cos(t * 1.2) * 0.06) + pointerY * 26,
        Math.max(width, height) * 0.42,
        'rgba(93,242,165,ALPHA)',
        0.1,
      );
      drawGlow(
        width * (0.78 + Math.cos(t * 1.1) * 0.05) + pointerX * 30,
        height * (0.18 + Math.sin(t * 1.5) * 0.05) + pointerY * 20,
        Math.max(width, height) * 0.38,
        'rgba(110,231,255,ALPHA)',
        0.07,
      );
      drawGlow(
        width * (0.55 + Math.sin(t * 0.8) * 0.08),
        height * (0.82 + Math.cos(t * 1.3) * 0.04),
        Math.max(width, height) * 0.32,
        'rgba(179,136,255,ALPHA)',
        0.045,
      );

      ctx.globalCompositeOperation = 'source-over';
      for (const star of stars) {
        star.y += star.speed;
        if (star.y > height + 2) star.y = -2;
        const twinkle = 0.45 + Math.sin(time * 0.0012 + star.phase) * 0.35;
        ctx.fillStyle = `rgba(217,230,239,${star.a * twinkle})`;
        ctx.beginPath();
        ctx.arc(star.x + pointerX * 8, star.y, star.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const loop = (time: number) => {
      if (!canvas.isConnected) return;
      if (visible && !document.hidden) draw(time);
      frame = window.requestAnimationFrame(loop);
    };

    resize();

    if (!reduced) {
      frame = window.requestAnimationFrame(loop);
      const observer = new IntersectionObserver((entries) => {
        visible = entries.some((entry) => entry.isIntersecting);
      });
      observer.observe(scene);
      window.addEventListener(
        'pointermove',
        (event) => {
          targetX = event.clientX / Math.max(window.innerWidth, 1);
          targetY = event.clientY / Math.max(window.innerHeight, 1);
        },
        { passive: true },
      );
    }

    const resizeObserver = new ResizeObserver(resize);
    resizeObserver.observe(scene);

    document.addEventListener('astro:before-swap', () => {
      if (frame) window.cancelAnimationFrame(frame);
      resizeObserver.disconnect();
    });
  }

  document.addEventListener('astro:page-load', bootHeroScene);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootHeroScene, { once: true });
  } else {
    bootHeroScene();
  }
</script>

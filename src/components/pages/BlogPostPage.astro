---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCover from '../PostCover.astro';
import { formatDate, type BlogPost } from '../../lib/blog';
import { route } from '../../i18n/ui';
import type { Lang } from '../../i18n/ui';

interface Props {
  post: BlogPost;
  lang: Lang;
  alternatePath: string;
  hasTranslation: boolean;
}

const { post, lang, alternatePath, hasTranslation } = Astro.props;
const { Content } = await render(post);
const blogRoute = route(lang, 'blog');
const slug = post.id.replace(/^(en|es)\//, '');

const copy = {
  en: {
    back: '← All posts',
    alternate: 'Leer en español',
    tags: 'Tags',
  },
  es: {
    back: '← Todas las entradas',
    alternate: 'Read in English',
    tags: 'Etiquetas',
  },
};

const c = copy[lang];
---

<BaseLayout
  lang={lang}
  title={`${post.data.title} — Miguel Cock`}
  description={post.data.description}
  alternatePath={alternatePath}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <div class="reading-progress" data-reading-progress aria-hidden="true"></div>

  <article class="post">
    <div class="container">
      <header class="post__header">
        <p class="eyebrow">
          <span class="eyebrow__mark">//</span>
          blog · {formatDate(post.data.pubDate, lang)}
        </p>
        <h1 class="post__title">{post.data.title}</h1>
        <p class="post__desc">{post.data.description}</p>
        {post.data.tags.length > 0 && (
          <div class="post__meta">
            <span>
              {c.tags}: {post.data.tags.join(' · ')}
            </span>
          </div>
        )}
      </header>

      <div class="post__cover" aria-hidden="true">
        <PostCover slug={slug} tags={post.data.tags} />
      </div>

      <div class="prose" data-prose>
        <Content />
      </div>

      <footer class="post__footer">
        <a href={blogRoute}>{c.back}</a>
        {hasTranslation ? (
          <a href={alternatePath} hreflang={lang === 'en' ? 'es' : 'en'}>
            {c.alternate} →
          </a>
        ) : (
          <span class="muted">
            {lang === 'en' ? 'Spanish version coming soon' : 'Versión en inglés próximamente'}
          </span>
        )}
      </footer>
    </div>
  </article>
</BaseLayout>

<script>
  function bootReadingProgress(): void {
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    if (!bar) return;

    const win = window as Window & { __mcReadingBound?: boolean };
    if (win.__mcReadingBound) return;
    win.__mcReadingBound = true;

    let frame = 0;
    const update = () => {
      frame = 0;
      const currentBar = document.querySelector<HTMLElement>('[data-reading-progress]');
      const prose = document.querySelector<HTMLElement>('[data-prose]');
      if (!currentBar || !prose) return;

      const rect = prose.getBoundingClientRect();
      const start = window.scrollY + rect.top;
      const end = start + prose.offsetHeight - window.innerHeight * 0.35;
      const progress = Math.min(1, Math.max(0, (window.scrollY - start) / (end - start)));
      currentBar.style.transform = `scaleX(${progress})`;
    };

    const onScroll = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  document.addEventListener('astro:page-load', bootReadingProgress);

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootReadingProgress, { once: true });
  } else {
    bootReadingProgress();
  }
</script>

---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { t } from '../i18n/ui';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  alternatePath: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
}

const {
  lang,
  title,
  description,
  alternatePath,
  image = '/og.png',
  type = 'website',
  publishedTime,
} = Astro.props;

const site = Astro.site ?? new URL('https://miguelcock.github.io');
const canonical = new URL(Astro.url.pathname, site);
const alternate = new URL(alternatePath, site);
const ogImage = new URL(image, site);
const copy = t(lang);
const locale = lang === 'en' ? 'en_US' : 'es_CO';
const alternateLocale = lang === 'en' ? 'es_CO' : 'en_US';
const ogAlt =
  lang === 'en'
    ? 'Miguel Cock — cybersecurity engineer and full-stack developer'
    : 'Miguel Cock — ingeniero en ciberseguridad y desarrollador full stack';

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: profile.displayName,
  url: site.href,
  jobTitle: profile.role.en,
  email: `mailto:${profile.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Medellín',
    addressCountry: 'CO',
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Exfil Security',
  },
  alumniOf: {
    '@type': 'CollegeOrUniversity',
    name: 'Universidad EAFIT',
  },
  sameAs: [profile.github, profile.linkedin],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#05070a" />
    <meta name="color-scheme" content="dark" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={lang === 'en' ? canonical : alternate} />
    <link rel="alternate" hreflang="es" href={lang === 'es' ? canonical : alternate} />
    <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : alternate} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta property="og:site_name" content="Miguel Cock" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline>
      document.documentElement.classList.remove('no-js');
      document.documentElement.classList.add('js');
    </script>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">
      {copy.skip}
    </a>
    <Header lang={lang} alternatePath={alternatePath} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="toast" data-toast role="status" aria-live="polite"></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
